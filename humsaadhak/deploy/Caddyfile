# Public HTTPS for HumSaadhak. Caddy obtains and renews certificates for DOMAIN and FILES_DOMAIN automatically
# (Let's Encrypt; "localhost" gets a local certificate), redirects http:// to https://, and speaks TLS 1.2/1.3 only.
# Traffic onwards to the app and to file storage is encrypted again and the internal certificates are verified.
{
	# "email <address>" when ACME_EMAIL is set, otherwise nothing: an "email" without an address stops Caddy
	# (the proxy container builds ACME_EMAIL_LINE at start; see deploy/compose.yaml)
	{$ACME_EMAIL_LINE}
}

{$DOMAIN} {
	tls {
		protocols tls1.2 tls1.3
	}
	encode zstd gzip
	reverse_proxy https://app:8443 {
		transport http {
			tls_trusted_ca_certs /tls/ca.crt
			tls_server_name app
		}
	}
}

# Document downloads: signed links from the app point here, so browsers fetch files over HTTPS.
{$FILES_DOMAIN} {
	tls {
		protocols tls1.2 tls1.3
	}
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy https://storage:9000 {
		header_up Host {host}
		transport http {
			tls_trusted_ca_certs /tls/ca.crt
			tls_server_name storage
		}
	}
}
