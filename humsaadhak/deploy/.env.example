# HumSaadhak 2.0 — local / trial settings for deploy/deploy.sh (Docker Compose).
# deploy/deploy.sh init fills every empty secret below with a random value.
# NEVER commit this file. Keep a copy offline: without HUMSAADHAK_FIELD_KEY and STORAGE_KMS_KEY, bank account numbers and
# document files cannot be read.

# ---------------------------------------------------------------- site
DOMAIN=
FILES_DOMAIN=
# Let's Encrypt expiry notices
ACME_EMAIL=
# On an empty database the first super admin is created for this address and emailed a set-password link
HUMSAADHAK_BOOTSTRAP_ADMIN_EMAIL=

# ---------------------------------------------------------------- database
# The local PostgreSQL container (profile local-db). Name, user and password as in the previous project's local setup
# (application.yaml: jdbc:postgresql://localhost:5432/saadhak_demo, postgres). The container is not reachable from outside.
COMPOSE_PROFILES=local-db,pgadmin
DB_HOST=
DB_PORT=5432
DB_NAME=humsaadhak
DB_USER=humsaadhak
DB_PASSWORD=
# Database where CREATE DATABASE runs (postgres)
DB_ADMIN_DB=postgres
# CA certificate the database's certificate is verified against (sslmode=verify-full)
DB_CA_FILE=./tls/out/ca.crt
# PostgreSQL client tools for backups and dumps of a managed database: major version at least the server's.
# deploy.sh tells you if they do not match (e.g. a PostgreSQL 17 cluster needs postgres:17).
DB_TOOLS_IMAGE=pgvector/pgvector:pg16

# The old system's database, read once by: deploy/deploy.sh dump-legacy (then migrate-legacy)
# (previous project, local setup: localhost:5432/saadhak_demo; deploy.sh reaches the host's localhost)
LEGACY_DB_HOST=
LEGACY_DB_PORT=
LEGACY_DB_NAME=
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
# verify-full for a managed database (uses DB_CA_FILE); disable for a database on this computer without TLS
LEGACY_DB_SSLMODE=disable

# ---------------------------------------------------------------- email: Microsoft Graph or SMTP
# MAIL_PROVIDER: log (written to the app's log, trials only) | graph (Microsoft Graph, OAuth) | smtp (an SMTP server).
# The previous project sent every email through Microsoft Graph as support@humsaadhak.com (azure.tenant-id, client-id,
# client-secret, application.mail-from). Its Brevo SMTP settings were never used and are not needed.
MAIL_PROVIDER=log
MAIL_FROM=support@humsaadhak.com
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# MAIL_PROVIDER=smtp, e.g. Microsoft 365: smtp.office365.com, port 587 (STARTTLS is required; certificates are checked).
# MAIL_FROM must be the SMTP_USERNAME mailbox, or one it may "Send As". A password containing $ goes in single quotes.
# Microsoft 365 turns off password sign-in for SMTP by default at the end of December 2026: Graph is the lasting choice.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Empty: the server's certificate is verified. A host name (e.g. smtp.office365.com) accepts that server's certificate
# without verifying it (mail.smtp.ssl.trust): still encrypted, but a forged certificate would be accepted.
SMTP_SSL_TRUST=
# Like the previous project's external-email-enable: false with internal-email-address: every email goes to this one mailbox
MAIL_REDIRECT_TO=
# With MAIL_PROVIDER=log on localhost only: also write the links in emails to the log (deploy/deploy.sh admin-link).
# Not needed here: with Graph and the redirect above, the set-password email arrives in that mailbox.
MAIL_LOG_LINKS=false

# ---------------------------------------------------------------- pgAdmin (database console, profile pgadmin)
# On: http://localhost:5050 (bound to 127.0.0.1, so only this computer). Run deploy_local.cmd pgadmin to open it.
# Its own sign-in below; the HumSaadhak database is pre-registered, and pgAdmin asks once for DB_PASSWORD.
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
PGADMIN_PORT=5050

# ---------------------------------------------------------------- service secrets (random; only used inside this server)
SEARCH_TOKEN=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Encrypts document files at rest (MinIO). 32 random bytes, base64. Never change it once files exist.
STORAGE_KMS_KEY=
# Encrypts bank account numbers at rest. 32 random bytes, base64. Never change it once data exists.
HUMSAADHAK_FIELD_KEY=

# ---------------------------------------------------------------- other
# true replaces the search models with a simple stand-in (demos on small machines only)
USE_FAKE_MODELS=false
# Matching: empty = the pretrained Qwen3 embedding model. After deploy_local.cmd match-train: /models/humsaadhak-embedding
EMBEDDING_MODEL=
# How widely match percentages spread (higher = more cautious). Reviewer decisions refine it (training/fit_calibration.py)
RERANK_TEMPERATURE=3.0
# Only for the one-time migration: set by deploy.sh migrate-legacy from its argument
LEGACY_UPLOAD_DIR=
# Image tags; deploy.sh update keeps the previous build as :previous for rollback
APP_TAG=latest
SEARCH_TAG=latest
